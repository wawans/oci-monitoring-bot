# ==============================================================================
# OCI Monitoring Telegram Bot - Environment Configuration Template
# ==============================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya:
# cp .env.example .env

# Telegram Bot Credentials
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ"

# Telegram Admin User ID (Hanya user ini yang memiliki akses ke bot)
# Dapatkan ID Anda via @userinfobot di Telegram
TELEGRAM_ADMIN_USER_ID=123456789

# Database Configuration
# Default menggunakan SQLite async (aiosqlite) dengan direktori lokal data/
DATABASE_URL="sqlite+aiosqlite:///data/oci_bot.db"

# Path Konfigurasi Multi-Akun OCI (YAML)
ACCOUNTS_CONFIG_PATH="config/accounts.yaml"

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Default Polling Intervals (dapat diubah dinamis lewat /settings di bot)
# Interval metrik & status VM dalam menit: 5, 10, atau 30
DEFAULT_METRICS_INTERVAL_MINUTES=10

# Interval tagihan & forecast dalam jam: 3, 6, atau 12
DEFAULT_BILLING_INTERVAL_HOURS=6
